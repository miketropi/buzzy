# Database (MySQL 8 — see docker-compose)
# docker compose up -d  then  npm run db:push
DATABASE_URL="mysql://buzzy:buzzy@127.0.0.1:3306/buzzy"

# Redis
REDIS_URL="redis://localhost:6379"

# NextAuth / Auth.js — use a long random string. AUTH_SECRET is an alias in v5.
NEXTAUTH_SECRET="generate-a-strong-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (Dashboard login — optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Email (notifications)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@buzzy.dev"

# SDK / public widget (origins only — do not include /api/v1; the embed appends paths)
NEXT_PUBLIC_SDK_URL="http://localhost:3000/buzzy.js"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Rate Limits
RATE_LIMIT_COMMENTS=5
RATE_LIMIT_REVIEWS=3
RATE_LIMIT_VOTES=30
RATE_LIMIT_REPORTS=10
RATE_LIMIT_UPLOADS=30

# Cloudflare R2 (optional — widget image uploads via presigned PUT).
# Configure the bucket CORS to allow browser PUT/GET from sites that embed buzzy.js.
# Allowed upload types: JPEG/ PNG / WebP / GIF images and MP4 / WebM / QuickTime (MOV) short clips.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
