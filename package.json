{
  "name": "buzzy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate && npm run gen:widget-chrome",
    "gen:widget-chrome": "node scripts/sync-widget-chrome.mjs",
    "build:embed": "node scripts/build-embed.mjs",
    "predev": "prisma generate && npm run gen:widget-chrome && npm run build:embed",
    "dev": "next dev",
    "build": "prisma generate && npm run gen:widget-chrome && npm run build:embed && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:deploy": "prisma db push",
    "db:push": "dotenv -c development -- prisma db push",
    "db:studio": "dotenv -c development -- prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1040.0",
    "@aws-sdk/s3-request-presigner": "^3.1040.0",
    "@prisma/client": "5.22.0",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "bcrypt": "^5.1.1",
    "ioredis": "^5.4.1",
    "lucide-react": "^1.14.0",
    "next": "14.2.18",
    "next-auth": "^5.0.0-beta.31",
    "prism-react-renderer": "^2.4.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.15.0",
    "sanitize-html": "^2.17.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sanitize-html": "^2.16.1",
    "dotenv-cli": "^7.4.2",
    "esbuild": "^0.24.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.18",
    "postcss": "^8",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
